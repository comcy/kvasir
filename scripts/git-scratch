#!/bin/sh
# git-scratch: detached Scratch-Worktrees to look at a ref in isolation.
# Same convention as `kvasir scratch`. Starts nothing but git.
#   git-scratch add <ref>              print the path on stdout
#   git-scratch list
#   git-scratch clean [<ref>] [--force]
set -u

die() { echo "git-scratch: $*" >&2; exit 1; }

common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not in a git repository"
case "$common" in
    */.bare) sd="${common%/.bare}/.scratch" ;;
    */.git) repo="${common%/.git}"; sd="${repo%/*}/${repo##*/}.scratch" ;;
    *) sd="${common%/*}/${common##*/}.scratch" ;;
esac

slug() { printf '%s' "$1" | sed 's|/|--|g'; }

list() {
    git worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r p; do
        case "$p" in "$sd"/*) printf '%s\n' "$p" ;; esac
    done
}

remove() {
    if [ -n "$force" ]; then git worktree remove --force "$1"; else git worktree remove "$1"; fi || return 1
    git worktree prune
}

cmd=${1:-}
[ $# -gt 0 ] && shift
force=""
case "$cmd" in
add)
    [ $# -eq 1 ] || die "usage: git-scratch add <ref>"
    ref=$1
    target="$sd/$(slug "$ref")"
    if [ -e "$target" ]; then printf '%s\n' "$target"; exit 0; fi
    git fetch --quiet >/dev/null 2>&1 || echo "git-scratch: warning: fetch failed" >&2
    for cand in "refs/heads/$ref" "refs/remotes/origin/$ref" "$ref"; do
        if git rev-parse --verify --quiet "$cand^{commit}" >/dev/null; then
            mkdir -p "$sd" || exit 1
            git worktree add --detach "$target" "$cand" >&2 || exit 1
            printf '%s\n' "$target"
            exit 0
        fi
    done
    die "unknown ref: $ref"
    ;;
list)
    list
    ;;
clean)
    ref=""
    for a in "$@"; do
        case "$a" in
            --force) force=1 ;;
            *) ref=$a ;;
        esac
    done
    rc=0
    if [ -n "$ref" ]; then
        remove "$sd/$(slug "$ref")" || rc=1
    else
        list > "${TMPDIR:-/tmp}/git-scratch.$$" || exit 1
        while IFS= read -r p; do remove "$p" || rc=1; done < "${TMPDIR:-/tmp}/git-scratch.$$"
        rm -f "${TMPDIR:-/tmp}/git-scratch.$$"
    fi
    exit $rc
    ;;
*)
    die "usage: git-scratch add <ref> | list | clean [<ref>] [--force]"
    ;;
esac
